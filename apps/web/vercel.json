{
  "redirects": [
    {
      "source": "/apt/pool/:release/amd64/mentari.deb",
      "destination": "https://github.com/evitxchi/mentari2.0/releases/download/:release/mentari-linux-x86_64.deb",
      "statusCode": 302
    },
    {
      "source": "/apt/pool/:release/arm64/mentari.deb",
      "destination": "https://github.com/evitxchi/mentari2.0/releases/download/:release/mentari-linux-aarch64.deb",
      "statusCode": 302
    },
    { "source": "/skill", "destination": "/skill.md", "statusCode": 301 },
    {
      "source": "/skills",
      "destination": "https://docs.anarlog.so/agents/skills",
      "statusCode": 301
    },
    { "source": "/docs", "destination": "https://docs.anarlog.so", "statusCode": 301 },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.anarlog.so/:path*",
      "statusCode": 301
    },
    {
      "source": "/blog/filesystem-is-coretex",
      "destination": "/blog/",
      "statusCode": 301
    },
    { "source": "/faq", "destination": "/", "statusCode": 301 },
    { "source": "/about", "destination": "/", "statusCode": 301 },
    { "source": "/roadmap", "destination": "/changelog/", "statusCode": 301 },
    { "source": "/roadmap/:path*", "destination": "/changelog/", "statusCode": 301 },
    { "source": "/legal/:path*", "destination": "/:path*", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/skill.md", "destination": "https://docs.anarlog.so/skill.md" },
    {
      "source": "/.well-known/skills/:path*",
      "destination": "https://docs.anarlog.so/.well-known/skills/:path*"
    },
    {
      "source": "/.well-known/agent-skills/:path*",
      "destination": "https://docs.anarlog.so/.well-known/agent-skills/:path*"
    },
    {
      "source": "/.well-known/vercel/:path*",
      "destination": "https://docs.anarlog.so/.well-known/vercel/:path*"
    }
  ],
  "headers": [
    {
      "source": "/apt/dists/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/apt/mentari-archive-keyring.asc",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "images": {
    "remotePatterns": [
      { "protocol": "https", "hostname": "char.com" },
      { "protocol": "https", "hostname": "hyprnote.com" },
      { "protocol": "https", "hostname": "ijoptyyjrfqwaqhyxkxj.supabase.co" }
    ]
  }
}
